# ==============================================================================
# RecoverAI - Environment Configuration Template
# Copy this file to .env and replace placeholder values with actual settings.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# FastAPI Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_development_secret_key_placeholder_change_in_production

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=recoverai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@localhost:5432/recoverai_db

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Razorpay Test Mode Credentials (To be configured in Phase 3)
RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# AI Agent Provider Configuration (To be configured in Phase 2)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
